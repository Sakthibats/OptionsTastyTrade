# Copy this file to .env, then replace the empty values locally.
# Never add real credentials to this committed template.

# Tastytrade account credentials (required for authenticated API calls)
TASTYTRADE_USERNAME=
TASTYTRADE_PASSWORD=

# Optional OAuth/API application credentials, if your Tastytrade access uses them.
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=

# Application behaviour
TASTYTRADE_ENVIRONMENT=production
LOG_LEVEL=INFO
