# Template for your local secrets file. Copy it yourself and fill in values:
#   cp env.example .env
# Claude is blocked from reading or editing .env (see .claude/settings.json).
#
# .env is read by the Cloudflare Worker during `npm run dev` (local only).
# In production these live as Cloudflare secrets: `npx wrangler secret put NAME`.
#
# NEVER prefix any of these with VITE_ — Vite ships VITE_* vars to the browser.

# --- tastytrade OAuth (my.tastytrade.com → Manage → My Profile → API → OAuth Applications)
# Create the grant with READ scope only unless you deliberately want trading.
TT_CLIENT_ID=
TT_CLIENT_SECRET=
TT_REFRESH_TOKEN=

# Production: https://api.tastyworks.com   Sandbox: https://api.cert.tastyworks.com
# (sandbox and production credentials are separate)
TT_API_BASE=https://api.tastyworks.com

# Local dev only: skip Cloudflare Access checks. Only honored on localhost.
AUTH_MODE=none
